#!/usr/bin/env bash
# ghostty-bg — switch Ghostty background: wallpaper, transparency, or none

GHOSTTY_CONFIG="${HOME}/dotfiles/ghostty/.config/ghostty/config"

usage() {
    cat <<EOF
ghostty-bg — change Ghostty background

Usage:
  ghostty-bg set <image>      Set wallpaper (path or ~/...)
  ghostty-bg clear            Remove image, use window transparency
  ghostty-bg opacity <0-1>    Adjust image/window opacity
  ghostty-bg status           Show current background settings

After any change, reload Ghostty with: cmd+r
EOF
}

_python_edit() {
    python3 - "$GHOSTTY_CONFIG" "$@" <<'PYEOF'
import sys, re

config_file = sys.argv[1]
mode = sys.argv[2]

with open(config_file, 'r') as f:
    content = f.read()

def remove_bg_keys(text):
    for key in ('background-image', 'background-image-fit',
                'background-image-opacity', 'background-opacity'):
        text = re.sub(rf'^{key}\s*=.*\n?', '', text, flags=re.MULTILINE)
    return text

if mode == 'set':
    img = sys.argv[3]
    content = remove_bg_keys(content)
    block = (f"\nbackground-image = {img}\n"
             f"background-image-fit = cover\n"
             f"background-image-opacity = 0.2\n")
    content = content.rstrip('\n') + '\n' + block

elif mode == 'clear':
    content = remove_bg_keys(content)
    content = content.rstrip('\n') + '\nbackground-opacity = 0.85\n'

elif mode == 'opacity':
    op = sys.argv[3]
    if re.search(r'^background-image-opacity\s*=', content, flags=re.MULTILINE):
        content = re.sub(r'^background-image-opacity\s*=.*',
                         f'background-image-opacity = {op}', content, flags=re.MULTILINE)
    elif re.search(r'^background-opacity\s*=', content, flags=re.MULTILINE):
        content = re.sub(r'^background-opacity\s*=.*',
                         f'background-opacity = {op}', content, flags=re.MULTILINE)
    else:
        content = content.rstrip('\n') + f'\nbackground-image-opacity = {op}\n'

with open(config_file, 'w') as f:
    f.write(content)
PYEOF
}

case "${1:-}" in
    set)
        [[ -z "$2" ]] && { usage; exit 1; }
        img="${2/#\~/$HOME}"
        [[ ! -f "$img" ]] && { echo "Error: not found: $img"; exit 1; }
        rel="${img/#$HOME/\~}"
        _python_edit set "$rel"
        echo "Wallpaper: $rel"
        echo "Reload: cmd+r"
        ;;
    clear)
        _python_edit clear
        echo "Transparency mode (opacity 0.85, no image)"
        echo "Reload: cmd+r"
        ;;
    opacity)
        [[ -z "$2" ]] && { usage; exit 1; }
        _python_edit opacity "$2"
        echo "Opacity set to $2"
        echo "Reload: cmd+r"
        ;;
    status)
        echo "=== Ghostty background ==="
        grep -E '^background' "$GHOSTTY_CONFIG" || echo "(none)"
        ;;
    *)
        usage
        ;;
esac
