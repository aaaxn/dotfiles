#!/usr/bin/env bash
# ghostty-bg — switch Ghostty background: wallpaper, transparency, or none

GHOSTTY_CONFIG="${HOME}/dotfiles/ghostty/.config/ghostty/config"
RELOAD_MSG="Reload: cmd+r"

usage() {
    cat <<EOF
ghostty-bg — change Ghostty background

Usage:
  ghostty-bg set <image>      Set wallpaper (path or ~/...)
  ghostty-bg clear            Remove image, use window transparency
  ghostty-bg opacity <0-1>    Adjust image/window opacity
  ghostty-bg status           Show current background settings

After any change, reload Ghostty with: cmd+r
EOF
}

_python_edit() {
    python3 - "$GHOSTTY_CONFIG" "$@" <<'PYEOF'
import sys, re, os

config_file = sys.argv[1]
mode = sys.argv[2]

try:
    with open(config_file, 'r') as f:
        content = f.read()
except OSError as e:
    print(f"Error reading config: {e}", file=sys.stderr)
    sys.exit(1)

BG_KEYS_RE = re.compile(
    r'^(background-image|background-image-fit|background-image-opacity|background-opacity)\s*=.*\n?',
    re.MULTILINE
)

def remove_bg_keys(text):
    return BG_KEYS_RE.sub('', text)

def append_setting(text, setting):
    return text.rstrip('\n') + '\n' + setting + '\n'

if mode == 'set':
    img = os.path.expanduser(sys.argv[3])
    if not os.path.isfile(img):
        print(f"Error: not found: {img}", file=sys.stderr)
        sys.exit(1)
    rel = '~' + img[len(os.path.expanduser('~')):]
    content = remove_bg_keys(content)
    content = append_setting(content,
        f"background-image = {rel}\n"
        f"background-image-fit = cover\n"
        f"background-image-opacity = 0.2")

elif mode == 'clear':
    content = remove_bg_keys(content)
    content = append_setting(content, 'background-opacity = 0.85')

elif mode == 'opacity':
    op = sys.argv[3]
    new, n = re.subn(r'^background-image-opacity\s*=.*', f'background-image-opacity = {op}',
                     content, flags=re.MULTILINE)
    if n == 0:
        new, n = re.subn(r'^background-opacity\s*=.*', f'background-opacity = {op}',
                         content, flags=re.MULTILINE)
    content = new if n > 0 else append_setting(content, f'background-image-opacity = {op}')

try:
    with open(config_file, 'w') as f:
        f.write(content)
except OSError as e:
    print(f"Error writing config: {e}", file=sys.stderr)
    sys.exit(1)
PYEOF
}

_validate_opacity() {
    python3 -c "
v = float('$1')
exit(0 if 0.0 <= v <= 1.0 else 1)
" 2>/dev/null || { echo "Error: opacity must be a number between 0 and 1"; exit 1; }
}

case "${1:-}" in
    set)
        [[ -z "$2" ]] && { usage; exit 1; }
        _python_edit set "$2"
        echo "Wallpaper: ${2/#$HOME/~}"
        echo "$RELOAD_MSG"
        ;;
    clear)
        _python_edit clear
        echo "Transparency mode (opacity 0.85, no image)"
        echo "$RELOAD_MSG"
        ;;
    opacity)
        [[ -z "$2" ]] && { usage; exit 1; }
        _validate_opacity "$2"
        _python_edit opacity "$2"
        echo "Opacity set to $2"
        echo "$RELOAD_MSG"
        ;;
    status)
        echo "=== Ghostty background ==="
        grep -E '^background' "$GHOSTTY_CONFIG" || echo "(none)"
        ;;
    *)
        usage
        ;;
esac
